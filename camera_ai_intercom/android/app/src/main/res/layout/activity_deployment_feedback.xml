<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/deploymentFeedbackRoot"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="#000000"
  android:gravity="center"
  android:orientation="vertical"
  android:padding="24dp">

  <ImageView
    android:id="@+id/deploymentFeedbackLogo"
    android:layout_width="200dp"
    android:layout_height="72dp"
    android:layout_marginBottom="32dp"
    android:contentDescription="VIVI Telematics"
    android:scaleType="fitCenter"
    android:src="@drawable/ic_vivi_brand" />

  <TextView
    android:id="@+id/deploymentFeedbackTitle"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:letterSpacing="0.08"
    android:text="VIVI TELEMATICS"
    android:textColor="#FFFFFF"
    android:textSize="18sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/deploymentFeedbackMessage"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:text="Please Wait"
    android:textColor="#FFFFFF"
    android:textSize="24sp"
    android:textStyle="bold" />

</LinearLayout>
