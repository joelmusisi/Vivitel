# Production signing for the Vivitel camera app (com.vivitel.camera).
# Copy this file to keystore.properties (same folder) and fill in real values.
# keystore.properties and the .jks file are gitignored — never commit secrets.
#
# Create a keystore once with:
#   keytool -genkeypair -v -keystore vivitel-release.jks -alias vivitel \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Then set:
storeFile=vivitel-release.jks
storePassword=CHANGE_ME
keyAlias=vivitel
keyPassword=CHANGE_ME
