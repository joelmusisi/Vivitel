# VPS process environment.
# Copy to backend/.env.vps for local or server-specific values.
# Production secrets live only on the server: /opt/Vivitel/backend/.env.vps
#
# CMS808 platform account/password credentials are separate from VIVI user
# sign-in. Configure them per site in the authenticated 808 GPS > Platform UI;
# never put CMS808 credentials in frontend build-time environment variables.

# Optional server-wide CMS808 fallback login, used when a site has no stored
# platform password (Trip Timeline / Historical / Movement reports, video).
# CMS808_ACCOUNT=
# CMS808_PASSWORD=
# CMS808_BASE_URL=https://gps.hboiot.com:8088

# Backblaze B2 — legacy/default bucket (Mitac, device artifacts, dual-read fallback).
# B2_KEY_ID=
# B2_APP_KEY=
# B2_BUCKET=
B2_REGION=ca-east-006
B2_ENDPOINT=https://s3.ca-east-006.backblazeb2.com

# Track module → VIVI-TRACK (telemetry + route libraries). Falls back to default when unset.
# B2_TRACK_KEY_ID=
# B2_TRACK_APP_KEY=
B2_BUCKET_TRACK=VIVI-TRACK

# Reports cold archive → Vivi-Reports (after 3 months hot). Falls back to default when unset.
# B2_REPORTS_KEY_ID=
# B2_REPORTS_APP_KEY=
B2_BUCKET_REPORTS=Vivi-Reports
REPORT_ARCHIVE_HOT_DAYS=90

# Valkey/Redis cache (localhost only — never expose :6379 publicly)
# VALKEY_URL=redis://:PASSWORD@127.0.0.1:6379
# VALKEY_TTL=30

# Postgres analytics mirror (SQLite remains source of truth)
# PG_MIRROR_DATABASE_URL=postgresql://vivitel:PASSWORD@127.0.0.1:5432/vivitel
# PG_MIRROR_POOL_MAX=5
# PG_MIRROR_POOL_MIN=1

# Required for Worker-to-VPS operational storage and report APIs. Configure the
# same secret as Cloudflare Worker API_KEY_PERMANENT; never commit the value.
# API_KEY=
#
# Worker telemetry forwarding is separate and remains disabled by default.
# WORKER_TELEMETRY_FORWARD_ENABLED=false
# WORKER_TELEMETRY_FORWARD_URL=https://api.vivitelematics.ca/ingest/telemetry
# WORKER_API_KEY=

# Traccar (HTTP client — remote host; do not install Java Traccar on small VPS)
# TRACCAR_BASE_URL=http://traccar.vivitelematics.ca
# TRACCAR_USERNAME=
# TRACCAR_PASSWORD=
# TRACCAR_TOKEN=
# TRACCAR_KICK_COMMAND=getgps

# Device TCP listeners (distinct ports; 0 = disabled)
# TELTONIKA_PORT=5027
# TELTONIKA_TENANT_ID=west-africa
# JT808_PORT=5015
# JT808_TENANT_ID=west-africa
# CONCOX_PORT=5013
# CONCOX_TENANT_ID=west-africa
# QUECLINK_PORT=5021
# QUECLINK_TENANT_ID=west-africa

# DEVICE_SERVER_DOMAIN=162.35.186.103
# DEVICE_SERVER_PORT=6574
# DEVICE_SERVER_PROTOCOL=http
# DEFAULT_TENANT_ID=west-africa

