# Copy to .env.production and edit before: docker compose -f docker-compose.production.yml --env-file .env.production up -d

POSTGRES_DB=vivitel
POSTGRES_USER=vivitel
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432

VALKEY_PASSWORD=change-me-valkey-password
VALKEY_PORT=6379

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# Wire these into systemd (backend/vps.service) on the VPS host:
# PG_MIRROR_DATABASE_URL=postgresql://vivitel:change-me-strong-password@127.0.0.1:5432/vivitel
# VALKEY_URL=redis://:change-me-valkey-password@127.0.0.1:6379
