{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "Vivitel VPS Overview",
  "uid": "vivi-vps-overview",
  "tags": ["vivitel"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": { "list": [] },
  "panels": [
    {
      "type": "stat",
      "title": "SQLite Storage",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "vivi_storage_sqlite", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "MEMORY", "color": "red" }, "1": { "text": "SQLITE", "color": "green" } } }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Valkey Cache",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "vivi_valkey_connected", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "CONNECTED", "color": "green" } } }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Postgres Mirror",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "vivi_postgres_mirror_enabled", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "OFF", "color": "yellow" }, "1": { "text": "ON", "color": "green" } } }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "B2 Blob Storage",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "vivi_b2_enabled", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "OFF", "color": "yellow" }, "1": { "text": "ON", "color": "green" } } }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Active Device TCP Conns",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "vivi_device_tcp_active_connections", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Telemetry Events",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "vivi_telemetry_events_total", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "HTTP Request Rate (req/s by status)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (status) (rate(vivi_http_requests_total[5m]))", "legendFormat": "{{status}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP Latency p95 (s) by route",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(vivi_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Process Memory (resident bytes)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "process_resident_memory_bytes", "legendFormat": "rss", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Event Loop Lag (s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "nodejs_eventloop_lag_seconds", "legendFormat": "lag", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Postgres Mirror Lag (events)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "vivi_postgres_mirror_lag_events", "legendFormat": "lag", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Worker Forward Queue Depth",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "vivi_worker_forward_queue_depth", "legendFormat": "queued", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "HTTP 429 Rate Limits / min",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "rate(vivi_rate_limit_exceeded_total[5m]) * 60", "legendFormat": "429/min", "refId": "A" }]
    }
  ]
}
