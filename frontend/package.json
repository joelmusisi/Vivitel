{
  "name": "vivi-telematics-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build && node scripts/verify-pages-dist.mjs",
    "predeploy": "powershell -NoProfile -ExecutionPolicy Bypass -File ..\\scripts\\Test-DeploymentDataSafety.ps1",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File ..\\..\\deploy-pages.ps1 -ProjectPath . -ProjectName vivi-telematics-frontend -Branch main",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "marketing:images": "python scripts/install-vivi-brand-assets.py && python scripts/install-marketing-products.py && python scripts/install-marketing-garmin-assets.py && python scripts/install-marketing-automotive-assets.py && python scripts/install-marketing-feature-assets.py"
  },
  "dependencies": {
    "@react-google-maps/api": "^2.20.8",
    "exceljs": "^4.4.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "node.js": "^0.0.1-security",
    "react": "^18.3.1",
    "react-clock": "^6.0.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-leaflet-cluster": "^2.1.0",
    "react-router-dom": "^6.30.2",
    "react-time-picker": "^8.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^7.3.1",
    "vitest": "^2.1.9",
    "wrangler": "^4.81.0"
  }
}
