<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications (APNs). Xcode switches this to "production" for App Store / TestFlight builds. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal Links: served by https://us.vivitelematics.ca/.well-known/apple-app-site-association -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:us.vivitelematics.ca</string>
	</array>
</dict>
</plist>
